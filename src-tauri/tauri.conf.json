{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCh Tomy Audio",
  "version": "0.1.4",
  "identifier": "pl.schtomy.podcast-audio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SCh Tomy: przygotowanie kazań do podcastu",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost https://api.github.com",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Przygotowanie nagrań kazań do podcastu",
    "copyright": "Społeczność Chrześcijańska Tomy",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/yt-dlp",
      "binaries/deno"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "binaries/FFMPEG_LICENSE.txt": "FFMPEG_LICENSE.txt",
      "binaries/FFMPEG_README.txt": "FFMPEG_README.txt",
      "binaries/YTDLP_LICENSE.txt": "YTDLP_LICENSE.txt",
      "binaries/DENO_LICENSE.txt": "DENO_LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Polish": "nsis/Polish.nsh"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
